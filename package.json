{
  "name": "chatty-bunny",
  "version": "0.1.0",
  "description": "An open-source, responsive React UI kit for learning products, built with Tailwind CSS 4.",
  "type": "module",
  "license": "MIT",
  "author": "Chatty Bunny contributors",
  "homepage": "https://sermixzhou.github.io/chatty-bunny/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sermixzhou/chatty-bunny.git"
  },
  "bugs": {
    "url": "https://github.com/sermixzhou/chatty-bunny/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "ui-kit",
    "design-system",
    "education",
    "components",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "brand/mascot-states.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "BRAND_LICENSE.md",
    "NOTICE"
  ],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icon": {
      "types": "./dist/types/components/Icon.d.ts",
      "import": "./dist/icon.js",
      "require": "./dist/icon.cjs"
    },
    "./primitives": {
      "types": "./dist/types/components/primitives.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    },
    "./forms": {
      "types": "./dist/types/components/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/forms.cjs"
    },
    "./cards": {
      "types": "./dist/types/components/cards.d.ts",
      "import": "./dist/cards.js",
      "require": "./dist/cards.cjs"
    },
    "./navigation": {
      "types": "./dist/types/components/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./learning": {
      "types": "./dist/types/components/learning.d.ts",
      "import": "./dist/learning.js",
      "require": "./dist/learning.cjs"
    },
    "./feedback": {
      "types": "./dist/types/components/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./brand": {
      "types": "./dist/types/components/brand.d.ts",
      "import": "./dist/brand.js",
      "require": "./dist/brand.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./mascot.png": "./brand/mascot-states.png",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:package && npm run build:site",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:site": "vite build --outDir site-dist",
    "preview": "vite preview --outDir site-dist",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.build.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build:package"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "27.0.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
